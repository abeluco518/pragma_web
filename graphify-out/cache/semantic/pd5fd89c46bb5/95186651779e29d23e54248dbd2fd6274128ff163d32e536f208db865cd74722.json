{"nodes": [{"id": "com_editar_editing_guide", "label": "Guia d'edici\u00f3 de la web (Website Editing Guide)", "file_type": "document", "source_file": "COM-EDITAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Site is built as plain static files with no build step so non-technical staff can edit in any text editor and re-upload to Hostinger. Frequently-changed content is centralised in lib/manifest.js; reserve copy also lives in each .html in case JavaScript does not run. The ?v=YYYYMMDD cache-busting param must be bumped on every upload so visitors get the fresh CSS/JS. equip.html is kept as a redirect to nosaltres.html#equip to avoid breaking old links. Editors must never invent data (col\u00b7legiacions, testimonials) and should leave \"[PENDENT]\" placeholders."}, {"id": "com_editar_manifest_js", "label": "lib/manifest.js content manifest", "file_type": "concept", "source_file": "COM-EDITAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "com_editar_hostinger", "label": "Hostinger (web hosting)", "file_type": "concept", "source_file": "COM-EDITAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "com_editar_formspree", "label": "Formspree form endpoint", "file_type": "concept", "source_file": "COM-EDITAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "com_editar_editing_guide", "target": "com_editar_manifest_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "COM-EDITAR.md", "source_location": null, "weight": 1.0}, {"source": "com_editar_editing_guide", "target": "com_editar_hostinger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "COM-EDITAR.md", "source_location": null, "weight":